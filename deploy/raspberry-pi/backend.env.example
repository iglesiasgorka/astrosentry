# Copy to /etc/spherex-explorer.env with root ownership and mode 0600.
# Replace this placeholder with secrets.token_urlsafe(32); never commit the real code.
SPX_DEMO_CODE=REPLACE_WITH_A_RANDOM_PRIVATE_CODE_BEFORE_START
SPX_STATE_DIR=/var/lib/spherex-explorer
SPX_ALLOWED_ORIGINS=https://spherex-explorer-one.vercel.app,http://127.0.0.1:5173
SPX_ACQUISITION_LIMIT=12
SPX_JOB_SECONDS=300
SPX_RETENTION_SECONDS=3600
SPX_STORAGE_MIB=1024
SPX_MAX_FIELD_DEG=0.1
